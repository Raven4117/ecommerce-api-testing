            {
              "name": "GET - Retrieve Single Cart",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Cart ID is 1\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.id).to.eql(1);\r\n});\r\n\r\npm.test(\"Cart has a valid user ID\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.userId).to.be.a(\"number\");\r\n    pm.expect(response.userId).to.be.above(0);\r\n});\r\n\r\npm.test(\"Cart contains 4 products\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.products).to.have.lengthOf(4);\r\n});\r\n\r\npm.test(\"Every product has the required fields\", function () {\r\n    const response = pm.response.json();\r\n\r\n    response.products.forEach(function (product) {\r\n        pm.expect(product.id).to.be.a(\"number\");\r\n        pm.expect(product.title).to.be.a(\"string\");\r\n        pm.expect(product.quantity).to.be.a(\"number\");\r\n        pm.expect(product.price).to.be.a(\"number\");\r\n    });\r\n});"
                    ]
