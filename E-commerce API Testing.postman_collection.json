            {
              "name": "POST - Create Shopping Cart",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "\r\nconst response = pm.response.json();\r\n\r\n// Check HTTP status\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\n// Check cart ID\r\npm.test(\"Cart has a valid ID\", function () {\r\n    pm.expect(response.id).to.be.a(\"number\");\r\n});\r\n\r\n// Check user ID\r\npm.test(\"Cart belongs to user 1\", function () {\r\n    pm.expect(response.userId).to.equal(1);\r\n});\r\n\r\n// Check number of products\r\npm.test(\"Cart contains 2 product entries\", function () {\r\n    pm.expect(response.products).to.have.lengthOf(2);\r\n});\r\n\r\n// Check product quantities\r\npm.test(\"Product quantities are correct\", function () {\r\n    pm.expect(response.products[0].id).to.equal(1);\r\n    pm.expect(response.products[0].quantity).to.equal(2);\r\n\r\n    pm.expect(response.products[1].id).to.equal(2);\r\n    pm.expect(response.products[1].quantity).to.equal(1);\r\n});\r\n\r\n// Check total products\r\npm.test(\"Total products is 2\", function () {\r\n    pm.expect(response.totalProducts).to.equal(2);\r\n});\r\n\r\n// Check total quantity\r\npm.test(\"Total quantity is 3\", function () {\r\n    pm.expect(response.totalQuantity).to.equal(3);\r\n});\r\n"
                    ]
                  }
                }
              ],
