              "name": "PUT - Update Shopping Cart",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Cart ID is 1\", function () {\r\n    pm.expect(response.id).to.equal(1);\r\n});\r\n\r\npm.test(\"User ID is 1\", function () {\r\n    pm.expect(response.userId).to.equal(1);\r\n});\r\n\r\npm.test(\"Cart contains 2 products\", function () {\r\n    pm.expect(response.products).to.have.lengthOf(2);\r\n});\r\n\r\npm.test(\"Product 1 quantity is 5\", function () {\r\n    const product = response.products.find(p => p.id === 1);\r\n    pm.expect(product).to.exist;\r\n    pm.expect(product.quantity).to.equal(5);\r\n});\r\n\r\npm.test(\"Product 2 quantity is 2\", function () {\r\n    const product = response.products.find(p => p.id === 2);\r\n    pm.expect(product).to.exist;\r\n    pm.expect(product.quantity).to.equal(2);\r\n});\r\n\r\npm.test(\"Total quantity is 7\", function () {\r\n    pm.expect(response.totalQuantity).to.equal(7);\r\n});\r\n"
