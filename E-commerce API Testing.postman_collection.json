                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response contains a carts array\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.carts).to.be.an(\"array\");\r\n    pm.expect(response.carts.length).to.be.above(0);\r\n});\r\n\r\npm.test(\"Every cart has an ID and user ID\", function () {\r\n    const response = pm.response.json();\r\n\r\n    response.carts.forEach(function (cart) {\r\n        pm.expect(cart.id).to.be.a(\"number\");\r\n        pm.expect(cart.userId).to.be.a(\"number\");\r\n    });\r\n});\r\n\r\npm.test(\"Every cart contains a products array\", function () {\r\n    const response = pm.response.json();\r\n\r\n    response.carts.forEach(function (cart) {\r\n        pm.expect(cart.products).to.be.an(\"array\");\r\n    });\r\n});"
                    ]
                  }
                }
              ],
